name: ci

# AN EXAMPLE, NOT A TEMPLATE-OWNED FILE. `bootstrap` installs it as
# .github/workflows/ci.yml.example — INERT, since GitHub runs only .yml/.yaml —
# when the project has no other workflow, and never touches it again: from then
# on the project owns it. Replace every `REPLACE:` line with the project's real
# build and test commands, then rename it to ci.yml. The placeholders fail on
# purpose, so a copy renamed without being filled in is a red build rather than
# a green lie; it is installed inert so that a repo with no build command yet
# (rathi-robot) does not start life with a check that is red on every push.
#
# The cheap structural checks live in guards.yml, which the template owns and
# `bootstrap` replaces on upgrade. Keeping the two apart is what lets an upgrade
# never clobber this file.
#
# Modelled on rathi-fitness's ci.yml, which gates a macOS job (10x billing on a
# private repo) on whether the diff touched the app at all.
on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: ci-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  # Which expensive jobs does this diff justify?
  #
  # Its own small job rather than `needs: guards`, because GitHub has no
  # cross-workflow `needs` — guards.yml's job outputs are not visible here.
  # Worth the runner-start because the jobs it gates can cost far more.
  scope:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      # `code` is emitted by guards.sh itself (everything not in SCOPE_SKIP).
      # Add one line here per SCOPE_RULES name in guards.conf you gate on.
      code: ${{ steps.scope.outputs.code }}
      app: ${{ steps.scope.outputs.app }}
    steps:
      # The default checkout — on a PR, the MERGE ref — on purpose, unlike
      # guards.yml. `scope` reads only the list of changed paths, and
      # merge-base(base, merge commit) is the base itself, so the diff is exactly
      # the PR's own changes either way; nothing here reads VERSION from the
      # working tree. The test/build jobs below want the merge ref outright:
      # they should test what main will be after the merge, not the branch in
      # isolation.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - id: scope
        env:
          # A PR diffs against its merge base. A push diffs against what was
          # there before it — and `github.event.before` is all-zeroes for the
          # first push to a new branch, where the whole tree is the change.
          BASE_SHA: ${{ github.event_name == 'pull_request'
                        && github.event.pull_request.base.sha
                        || github.event.before }}
          HEAD_SHA: ${{ github.sha }}
        run: |
          set -euo pipefail
          # Three ways there is no base to diff against, not one: unset, the
          # all-zeroes first push to a branch, and — the one that bit
          # rathi-fitness — a SHA that is real but GONE, because the branch was
          # force-pushed and `github.event.before` still names the pre-rewrite
          # commit. That last case died with "fatal: Not a valid commit name"
          # and took the whole run down, on a push whose only sin was
          # rewriting history. rathi-budgeting's hand copy lacked this check.
          if [ -z "${BASE_SHA:-}" ] \
             || [ "$BASE_SHA" = "0000000000000000000000000000000000000000" ] \
             || ! git cat-file -e "${BASE_SHA}^{commit}" 2>/dev/null; then
            echo "no usable base — treating everything as changed"
            echo "code=true" >> "$GITHUB_OUTPUT"
            echo "app=true"  >> "$GITHUB_OUTPUT"
            exit 0
          fi
          BASE_SHA="$BASE_SHA" HEAD_SHA="$HEAD_SHA" bash .github/scripts/guards.sh scope

  test:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    needs: [scope]
    # `always()` because `scope` can be skipped, and a skipped dependency would
    # otherwise take this job down with it.
    if: always() && needs.scope.outputs.code == 'true'
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # Call the SAME entry point a developer runs (a Makefile target), so CI
      # and a laptop cannot drift. Override only what genuinely differs on a
      # runner (a destination, a toolchain path).
      - name: test
        run: |
          set -euo pipefail
          echo "REPLACE: e.g. make test" >&2
          exit 1

  # A second, expensive job gated on its own scope key — the rathi-fitness
  # shape, where this is a macos-15 runner. Delete it if you have one stack.
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    needs: [scope]
    if: always() && needs.scope.outputs.app == 'true'
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: build
        run: |
          set -euo pipefail
          echo "REPLACE: e.g. make build" >&2
          exit 1
